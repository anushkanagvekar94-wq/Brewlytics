# ==========================================
# BREWLYTICS LOCAL ENVIRONMENT CONFIGURATION
# ==========================================

# 1. GEMINI API KEY (Get a free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# 2. POSTGRESQL DATABASE
# You can use a local PostgreSQL instance (e.g. postgresql://postgres:postgres@localhost:5432/brewlytics)
# or a free hosted PostgreSQL from Neon (https://neon.tech) / Supabase (https://supabase.com)
DATABASE_URL="postgresql://postgres:password@localhost:5432/brewlytics"

# Alternatively, you can specify individual connection parameters:
# SQL_HOST="localhost"
# SQL_PORT="5432"
# SQL_USER="postgres"
# SQL_PASSWORD="your_password"
# SQL_DB_NAME="brewlytics"

# 3. JWT SECRET FOR AUTHENTICATION TOKENS
JWT_SECRET="brewlytics-jwt-secret-local-development-key-change-in-prod"

# 4. APP URL (Optional for local dev)
APP_URL="http://localhost:3000"
